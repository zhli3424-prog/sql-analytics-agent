# Copy this file to .env and add your own DeepSeek API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

APP_USERNAME=analyst
APP_ROLE=admin
APP_PASSWORD=1
ALLOW_WEAK_LOCAL_PASSWORD=true
SESSION_SECRET=change-this-session-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

POSTGRES_DB=analytics_agent
POSTGRES_USER=analytics_owner
POSTGRES_PASSWORD=change-this-owner-password
ANALYTICS_READ_PASSWORD=change-this-reader-password
DATABASE_URL=postgresql+psycopg://analytics_owner:change-this-owner-password@postgres:5432/analytics_agent
ANALYTICS_READ_URL=postgresql+psycopg://analytics_reader:change-this-reader-password@postgres:5432/analytics_agent

ANALYTICS_SCHEMA=analytics
ANALYTICS_ALLOWED_TABLES=categories,customers,products,orders,order_items,payments,refunds
BUSINESS_GLOSSARY_FILE=config/business_glossary.md
SEED_DEMO_DATA=true
QUERY_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200
QUERY_RATE_LIMIT_PER_MINUTE=20
ADMIN_IMPORT_ENABLED=true
MAX_IMPORT_BYTES=10485760
MAX_IMPORT_ROWS=100000
LOG_LEVEL=INFO

