# Copy this file to .env and add your own DeepSeek API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

POSTGRES_DB=analytics_agent
POSTGRES_USER=analytics_owner
POSTGRES_PASSWORD=change-this-owner-password
ANALYTICS_READ_PASSWORD=change-this-reader-password
DATABASE_URL=postgresql+psycopg://analytics_owner:change-this-owner-password@postgres:5432/analytics_agent
ANALYTICS_READ_URL=postgresql+psycopg://analytics_reader:change-this-reader-password@postgres:5432/analytics_agent

QUERY_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200
LOG_LEVEL=INFO

